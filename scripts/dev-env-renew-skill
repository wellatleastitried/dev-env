#!/bin/bash

echo "Renewing dev-env skill..."

SOURCE_SKILL_FILE="$PATH_DEV_ENV/ref/dev-env-skill/SKILL.md"
SKILL_DIRS=(
    "$HOME/.agents/skills/dev-env"
    "$HOME/.claude/skills/dev-env"
)

if [ ! -f "$SOURCE_SKILL_FILE" ]; then
    echo -e "${RED:-}Source skill not found: $SOURCE_SKILL_FILE${NC:-}" >&2
    exit 1
fi

for dir in "${SKILL_DIRS[@]}"; do
    dest="$dir/SKILL.md"

    if [ ! -d "$dir" ]; then
        mkdir -p "$dir"
        echo -e "${GREEN}Created $dir${NC}"
    fi

    if cmp -s "$SOURCE_SKILL_FILE" "$dest"; then
        echo -e "${GREEN}SKILL.md is already up to date at $dest${NC}"
    else
        cp "$SOURCE_SKILL_FILE" "$dest"
        echo -e "${GREEN}Copied SKILL.md to $dest${NC}"
    fi
done

echo -e "${GREEN}dev-env skill renewed.${NC}"
