#!/bin/bash

cmd_update() {
    source "$PATH_DEV_ENV/scripts/dev-env-update-configs"
}

cmd_edit() {
    if [ "$1" == "help" ]; then
        echo "Open the configs for your dev-env in your editor."
        return 0
    fi
    source "$PATH_DEV_ENV/scripts/dev-env-edit-configs"
}

cmd_add() {
    case "$1" in
        help)
            echo "Usage: $(basename $0) add [alias|path|custom]"
            echo "  alias  - Add a new alias to your shell configuration"
            echo "  path   - Add a new path to your PATH environment variable"
            echo "  custom - Add a custom line to your shell configuration"
            ;;
        alias)
            source "$PATH_DEV_ENV/scripts/dev-env-add-alias"
            ;;
        path)
            source "$PATH_DEV_ENV/scripts/dev-env-add-path"
            ;;
        custom)
            source "$PATH_DEV_ENV/scripts/dev-env-add-custom-line"
            ;;
        *)
            select choice in "Alias" "PATH" "Custom" "Exit"; do
                case $choice in
                    Alias) source "$PATH_DEV_ENV/scripts/dev-env-add-alias"; break ;;
                    PATH)  source "$PATH_DEV_ENV/scripts/dev-env-add-path"; break ;;
                    Custom) source "$PATH_DEV_ENV/scripts/dev-env-add-custom-line"; break ;;
                    Exit) echo "Exiting..."; exit 0 ;;
                esac
            done
            ;;
    esac
}

cmd_help() {
    if [ -z "$1" ]; then
        echo "Usage: $(basename $0) command"
        echo "Commands:"
        echo "  update    Update the development environment configurations"
        echo "  add       Add to your shell environment (alias, PATH, or custom)"
        echo "  edit      Edit dev-env configuration files"
        echo "  help      Show help (or 'command help' for command-specific info)"
        return 0
    fi

    case "$1" in
        hypr)
            echo "Find your config file. Likely in ~/.config/hypr/hyprland.conf"
            echo "  Unbind: unbind = SUPER, left"
            echo "  Bind (example): bindd = SUPER, H, Move focus left, movefocus, l"
            ;;
        i3)
            echo "Find your config file. Likely in ~/.config/i3/config"
            echo "  Bind (example): bindsym \$mod+H focus left"
            ;;
        vim)
            echo "How to exit vim/nvim:"
            echo "  Wait holy shit I completely forgot..."
            ;;
        *)
            echo "Unknown topic: $1"
            return 1
            ;;
    esac
}

main() {
    local cmd="${1:-update}"
    shift || true

    case "$cmd" in
        update) cmd_update "$@" ;;
        edit)   cmd_edit "$@" ;;
        add)    cmd_add "$@" ;;
        help)   cmd_help "$@" ;;
        *)
            echo "Unknown command: $cmd"
            cmd_help
            exit 1
            ;;
    esac
}

main "$@"
